{
  "name": "smp-al-madinah",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.scripts.json",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "tsx scripts/seed.ts --local",
    "seed:remote": "tsx scripts/seed.ts --remote",
    "seed:mapel:local": "tsx scripts/seed-mapel.ts --local",
    "seed:mapel:remote": "tsx scripts/seed-mapel.ts --remote",
    "migrate:permissions:local": "tsx scripts/migrate-tahap2-permissions.ts --local",
    "migrate:permissions:remote": "tsx scripts/migrate-tahap2-permissions.ts --remote",
    "migrate:permissions3:local": "tsx scripts/migrate-tahap3-permissions.ts --local",
    "migrate:permissions3:remote": "tsx scripts/migrate-tahap3-permissions.ts --remote",
    "seed:dummy:local": "tsx scripts/seed-dummy-tahap3.ts",
    "migrate:permissions4:local": "tsx scripts/migrate-tahap4-permissions.ts --local",
    "migrate:permissions4:remote": "tsx scripts/migrate-tahap4-permissions.ts --remote",
    "cf-typegen": "wrangler types",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@vladmandic/human": "^3.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.55.0",
    "nanoid": "^6.0.2",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
